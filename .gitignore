# ══════════════════════════════════════════════════════════════════
#  Snake Knot — .gitignore
#  ASLA DEPOYA GİRMEYECEKLER — imzalama sırları
# ══════════════════════════════════════════════════════════════════
*.keystore
*.jks
keystore.properties
!keystore.properties.ornek
google-services.json
*.p8
*.p12
local.properties

# ── derleme çıktıları ──────────────────────────────────────────────
node_modules/
build/
.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.apk
*.aab
*.aar

# ── üretilen paket ─────────────────────────────────────────────────
