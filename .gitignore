# okuyor. Bu yüzden üretilen paketi takip etmiyoruz — Monoblock'la aynı
# düzen. Derlemek için: node yap.js  →  npx cap sync android
www/index.html

# ── yedek ve deneme dosyaları ──────────────────────────────────────
*.bak
*.bak[0-9]*
native.js.bak*

# ── editör ve işletim sistemi ──────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ── geçici ─────────────────────────────────────────────────────────
*.log
*.tar.gz
tmp/
